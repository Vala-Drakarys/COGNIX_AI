{
  "name": "cognix-combined",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "backend:install": "python -m pip install -r backend/agent_backend/requirements.txt",
    "backend:dev": "python backend/agent_backend/run.py",
    "dev:full": "node scripts/dev-full.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^18.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "esbuild": "^0.25.0"
  }
}
